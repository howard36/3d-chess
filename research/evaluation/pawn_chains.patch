+  /** `side`'s pawns that another of its pawns defends. */
+  private chain(side: number): number {
+    const board = this.board;
+    const pawn = side === WHITE_SIDE ? PAWN : PAWN | BLACK;
+    let n = 0;
+    for (let word = 0; word < 4; word++) {
+      let bits = this.occ[(side << 2) | word];
+      while (bits !== 0) {
+        const low = bits & -bits;
+        bits ^= low;
+        const c = (word << 5) | (31 - Math.clz32(low));
+        if (board[c] === pawn && this.pawnsOn(c, side, -1) > 0) n++;
+      }
+    }
+    return n;
+  }
+
+  /**
+   * The change to chain(side) when one of `side`'s pawns has just left
+   * `from` for `to` (-1: it promoted there), the board already showing it.
+   */
+  private chainMoved(side: number, from: number, to: number): number {
+    const board = this.board;
+    const pawn = side === WHITE_SIDE ? PAWN : PAWN | BLACK;
+    const caps = PAWN_CAP[side];
+    let d = this.pawnsOn(from, side, -1) > 0 ? -1 : 0;
+    // The pawns it defended from `from`, now left with no other
+    for (let i = 0, len = PAWN_CAP_LEN[side][from]; i < len; i++) {
+      const c = caps[from * 5 + i];
+      if (c !== to && board[c] === pawn && this.pawnsOn(c, side, -1) === 0) d--;
+    }
+    if (to < 0) return d;
+    if (this.pawnsOn(to, side, -1) > 0) d++;
+    // The pawns it defends from `to` that had no defender (`from` was not one)
+    for (let i = 0, len = PAWN_CAP_LEN[side][to]; i < len; i++) {
+      const c = caps[to * 5 + i];
+      if (board[c] !== pawn || this.pawnsOn(c, side, -1) !== 1) continue;
+      let k = 0;
+      const n = PAWN_CAP_LEN[side][from];
+      while (k < n && caps[from * 5 + k] !== c) k++;
+      if (k === n) d++;
+    }
+    return d;
+  }
+
+  /** The change to chain(side) when its pawn on `cell` has just been taken. */
+  private chainTaken(side: number, cell: number): number {
+    const board = this.board;
+    const pawn = side === WHITE_SIDE ? PAWN : PAWN | BLACK;
+    const caps = PAWN_CAP[side];
+    let d = this.pawnsOn(cell, side, -1) > 0 ? -1 : 0;
+    for (let i = 0, len = PAWN_CAP_LEN[side][cell]; i < len; i++) {
+      const c = caps[cell * 5 + i];
+      if (board[c] === pawn && this.pawnsOn(c, side, -1) === 0) d--;
+    }
+    return d;
+  }
