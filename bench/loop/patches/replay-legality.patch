+    const dest = cellOf(to.x, to.y, to.z);
+    const target = cells[dest];
+    if (target && target.color === color) return false;
+    if (piece.type === PieceType.Pawn) {
+      const dir = color === 'white' ? 1 : -1;
+      const step =
+        (to.x === from.x && to.y === from.y + dir && to.z === from.z) ||
+        (to.x === from.x && to.y === from.y && to.z === from.z + dir);
+      if (target ? !PAWN_CAPTURES[color][at].includes(dest) : !step) return false;
+      const due = this.isPromotionSquare(to, color);
+      if (due !== (promotion !== undefined)) return false;
+      if (due && !ALL_PROMOTION_TYPES.includes(promotion!)) return false;
+    } else {
