+      if (piece.type === PieceType.Knight) {
+        if (!KNIGHT_JUMPS[at].includes(dest)) return false;
+      } else if (!this.reaches(piece.type, at, dest)) return false;
+    }
+    return this.isSafe(move, piece, this.kingCell(color));
+  }
+
+  /** Whether a ray piece of `type` on `at` reaches `dest` (stopping at the first piece). */
+  private reaches(type: PieceType, at: number, dest: number): boolean {
+    const { from: d0, to: d1, sliding } = DIRECTIONS[type];
+    const rays = RAYS[at];
+    for (let d = d0; d < d1; d++) {
+      const ray = rays[d];
+      const reach = sliding ? ray.length : Math.min(1, ray.length);
+      for (let n = 0; n < reach; n++) {
+        if (ray[n] === dest) return true;
+        if (this.cells[ray[n]]) break;
+      }
+    }
+    return false;
+  }
