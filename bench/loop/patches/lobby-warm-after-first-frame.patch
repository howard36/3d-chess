+/**
+ * Links the programs of what the lobby draws only later (a seat's ring, a
+ * king's column of light with its floor and motes, the garden's copy at
+ * rest) right after its first frame, while the page waits for a click:
+ * otherwise each links inside the frame that first draws it, a long task in
+ * software, and on a guest's page all of them come after "Join game",
+ * between the click and the board's first frame. Nothing is drawn for it
+ * (linkAhead) and the lobby's first frame does not wait; the programs are
+ * kept (keepPrograms) for the lobby's own materials to draw with.
+ */
+const LobbyWarm = () => {
+  const gl = useThree((s) => s.gl);
+  const scene = useThree((s) => s.scene);
+  const camera = useThree((s) => s.camera);
+  useEffect(() => {
+    const selection = selectionMaterials(new Color(PALETTE.select));
+    const bare = [backdropMaterial()];
+    const meshes = [seatRingMaterial(), selection.columnMaterial, selection.floorMaterial];
+    const points = [selection.moteMaterial];
+    const materials = [...bare, ...meshes, ...points];
+    const { group, dispose } = warmObjects(meshes, points, bare);
+    let live = true;
+    const done = () => {
+      if (!live) return;
+      live = false;
+      const kept = keepPrograms(gl, materials);
+      for (const m of materials) if (!kept.has(m)) m.dispose();
+      dispose();
+    };
+    // Handed to the GPU right after the lobby's first frame (queued behind
+    // its draws; the page waits on none of it)
+    const start = () => {
+      if (live) linkAhead(gl, group, camera, done, scene);
+    };
+    let restore: (() => void) | null = null;
+    if (gl.info.render.frame > 0) start();
+    else {
+      const after = scene.onAfterRender;
+      restore = () => {
+        scene.onAfterRender = after;
+        restore = null;
+      };
+      scene.onAfterRender = function (...args) {
+        restore?.();
+        after.apply(this, args);
+        start();
+      };
+    }
+    return () => {
+      restore?.();
+      if (!live) return;
+      live = false;
+      for (const m of materials) m.dispose();
+      dispose();
+    };
+  }, [gl, scene, camera]);
+  return null;
+};
