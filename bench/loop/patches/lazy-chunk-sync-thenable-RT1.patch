+++ b/client/src/lib/cachedImport.ts
@@ -35,22 +35,36 @@ export const cachedImport = <T>(load: () => Promise<T>): (() => Promise<T>) => {
 /**
  * A component from a chunk of its own (a canvas), for the page around it to
  * show without waiting; `preload` asks for the chunk before it first renders.
- * React.lazy keeps its first failure for good, so `retry` makes a fresh one,
- * which asks for the chunk again, for the next render to use. Render it
- * inside a ChunkBoundary.
+ * A chunk that has arrived renders in the page's own commit: its lazy is
+ * handed it at once (a thenable that answers as it is asked), where a
+ * promise, even one settled, would suspend the part once, and React holds
+ * the commit that reveals a suspended part until 300 ms after its fallback
+ * showed. React.lazy keeps its first failure for good, so `retry` makes a
+ * fresh one, which asks for the chunk again, for the next render to use.
+ * Render it inside a ChunkBoundary.
  */
 // As React.lazy's own: any component, whatever its props
 // eslint-disable-next-line @typescript-eslint/no-explicit-any
 export const lazyChunk = <C extends ComponentType<any>>(load: () => Promise<{ default: C }>) => {
   const get = cachedImport(load);
-  let component = lazy(get);
+  let loaded: { default: C } | null = null;
+  const track = () => get().then((module) => (loaded = module));
+  const make = () =>
+    lazy(() => {
+      const module = loaded;
+      if (!module) return track();
+      return { then: (resolve: (m: { default: C }) => void) => resolve(module) } as Promise<{
+        default: C;
+      }>;
+    });
+  let component = make();
   return {
     get Component() {
       return component;
     },
-    preload: () => void get().catch(() => {}),
+    preload: () => void track().catch(() => {}),
     retry: () => {
-      component = lazy(get);
+      component = make();
     },
   };
 };
diff --git a/client/src/lib/lazyChunk.test.tsx b/client/src/lib/lazyChunk.test.tsx
new file mode 100644
index 0000000..6fc2971
--- /dev/null
+++ b/client/src/lib/lazyChunk.test.tsx
@@ -0,0 +1,33 @@
+import { Suspense } from 'react';
+import { render, screen } from '@testing-library/react';
+import { expect, it } from 'vitest';
+import { lazyChunk } from './cachedImport';
+
+const fallback = <p>waiting</p>;
+
+it('renders a chunk already loaded in the page’s own commit, never its fallback', async () => {
+  const chunk = lazyChunk(() => Promise.resolve({ default: () => <p>canvas</p> }));
+  chunk.preload();
+  await new Promise((r) => setTimeout(r));
+  const { Component } = chunk;
+  render(
+    <Suspense fallback={fallback}>
+      <Component />
+    </Suspense>,
+  );
+  // (React.lazy suspends once even here, and reveals it up to 300 ms later)
+  expect(screen.getByText('canvas')).toBeInTheDocument();
+  expect(screen.queryByText('waiting')).toBeNull();
+});
+
+it('shows the fallback while the chunk is on its way, then the chunk', async () => {
+  const chunk = lazyChunk(() => Promise.resolve({ default: () => <p>canvas</p> }));
+  const { Component } = chunk;
+  render(
+    <Suspense fallback={fallback}>
+      <Component />
+    </Suspense>,
+  );
+  expect(screen.getByText('waiting')).toBeInTheDocument();
+  expect(await screen.findByText('canvas')).toBeInTheDocument();
+});
