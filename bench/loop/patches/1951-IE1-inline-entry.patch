+/**
+ * (Rejected, run 20261020-1951 IE1.) The entry and the chunks it imports
+ * statically ride in the HTML as `data:` modules behind an import map, and
+ * its styles as a `<style>`, so a phone's first visit needs no round trip
+ * after the HTML for the entry.
+ */
+const INLINED_PREFIX = '@inline/';
+const inlineEntry = (): Plugin => {
+  let outDir = 'dist';
+  return {
+    name: 'inline-entry',
+    apply: 'build',
+    enforce: 'post',
+    configResolved(config) {
+      outDir = resolve(config.root, config.build.outDir);
+    },
+    writeBundle(_options, bundle) {
+      const chunks = Object.values(bundle).filter((c) => c.type === 'chunk');
+      const entry = chunks.find((c) => c.isEntry);
+      if (!entry) this.error('inline-entry: no entry chunk');
+      const inlined = [entry.fileName, ...entry.imports];
+      const base = (f: string) => f.replace(/^assets\//, '');
+      const names = chunks.map((c) => base(c.fileName));
+      const read = (f: string) => readFileSync(resolve(outDir, f), 'utf8');
+      const data = new Map<string, string>();
+      for (const f of inlined) {
+        let code = read(f);
+        for (const n of names)
+          for (const q of ['"', "'", '`']) code = code.replaceAll(`${q}./${n}${q}`, `${q}${INLINED_PREFIX}${n}${q}`);
+        code = code.replaceAll('import.meta', `({url:new URL(${JSON.stringify(`/${f}`)},location.href).href})`);
+        const left = /["'`]\.\.?\/|import\.meta/.exec(code);
+        if (left) this.error(`inline-entry: ${f} keeps ${code.slice(left.index, left.index + 40)}`);
+        const encoded = code.replace(/[%#\t\n\r]/g, (c) => encodeURIComponent(c));
+        data.set(f, `data:text/javascript;charset=utf-8,${encoded}`);
+      }
+      const imports: Record<string, string> = {};
+      for (const c of chunks) {
+        const n = base(c.fileName);
+        const d = data.get(c.fileName);
+        if (d) imports[`/${c.fileName}`] = d;
+        if (c !== entry) imports[`${INLINED_PREFIX}${n}`] = d ?? `/${c.fileName}`;
+      }
+      const map = JSON.stringify({ imports }).replace(/</g, '\\u003c');
+      const css = [...(entry.viteMetadata?.importedCss ?? [])];
+      for (const page of ['index.html', 'invite.html']) {
+        const path = resolve(outDir, page);
+        let html = readFileSync(path, 'utf8');
+        const script = new RegExp(`<script type="module" crossorigin src="/${entry.fileName}"></script>`);
+        if (!script.test(html)) this.error(`inline-entry: ${page} has no entry script`);
+        html = html.replace(
+          script,
+          () =>
+            `<script type="importmap">${map}</script>\n    <script type="module">import"/${entry.fileName}"</script>`,
+        );
+        for (const f of entry.imports) html = html.replace(`<link rel="modulepreload" crossorigin href="/${f}">`, '');
+        for (const f of css) {
+          const text = read(f).replace(/<\/style/gi, '<\\/style');
+          html = html.replace(`<link rel="stylesheet" crossorigin href="/${f}">`, () => `<style>${text}</style>`);
+        }
+        writeFileSync(path, html);
+      }
+    },
+  };
+};
