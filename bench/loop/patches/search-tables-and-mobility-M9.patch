index 396c570..c9c3c2b 100644
--- a/client/src/ai/evaluate.ts
+++ b/client/src/ai/evaluate.ts
@@ -16,6 +16,8 @@ import {
   CENTRE,
   DIST,
   PHASE_MAX,
