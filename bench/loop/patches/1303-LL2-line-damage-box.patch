+const start = new Vector3();
+const end = new Vector3();
+
+/**
+ * The part of a straight line from `from` to `to` drawn at reveal `reveal`
+ * (local space, in `out`), or null while none is: its fragments run from
+ * one radius before the source to one past the destination (the caps), and
+ * those past `reveal` are discarded.
+ */
+export const revealedBox = (
+  from: Vec3,
+  to: Vec3,
+  radius: number,
+  reveal: number,
+  out: Box3,
+): Box3 | null => {
+  if (reveal < -radius) return null;
+  start.fromArray(from);
+  end.fromArray(to);
+  const length = start.distanceTo(end);
+  const k = length > 0 ? Math.min(Math.max(reveal, 0), length) / length : 0;
+  out.makeEmpty();
+  out.expandByPoint(start);
+  out.expandByPoint(end.sub(start).multiplyScalar(k).add(start));
+  return out.expandByScalar(radius);
+};
