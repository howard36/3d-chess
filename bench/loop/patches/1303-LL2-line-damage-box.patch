     await act(async () => r.advanceFrames(20, 1 / 30));
     expect(u.uReveal.value).toBeGreaterThan(100);
   });
+
+  it('tells the damage tracking only the part drawn so far, and nothing before it starts', async () => {
+    const radius = 0.02;
+    const r = await ReactThreeTestRenderer.create(
+      <LastMoveLine
+        from={FROM}
+        to={TO}
+        radius={radius}
+        drawInMs={400}
+        drawInDelayMs={100}
+        {...LOOK}
+      />,
+    );
+    const [tube] = meshes(r.scene as ReactThreeTestInstance);
+    const box = tube.userData.damageBox as DamageBox;
+    const u = (tube.material as ShaderMaterial).uniforms;
+    // Waiting to draw in: nothing drawn
+    expect(box(new Box3())).toBeNull();
+    // Every vertex the shader keeps at a reveal lies in the box for it
+    const g = tube.geometry as BufferGeometry;
+    const along = g.getAttribute('aAlong');
+    const position = g.getAttribute('position');
+    const v = new Vector3();
+    const length = Math.hypot(2, 1.35, -1);
+    for (const reveal of [-radius, 0, 0.3, length / 2, length, length + radius, 1e6]) {
+      u.uReveal.value = reveal;
+      const b = box(new Box3())!;
+      expect(b).not.toBeNull();
+      for (let i = 0; i < along.count; i++) {
+        if (along.getX(i) > reveal) continue;
+        v.fromBufferAttribute(position, i);
+        expect(b.distanceToPoint(v)).toBeLessThan(1e-6);
+      }
+    }
+    // Part of the way, it stops short of the destination
+    expect(revealedBox(FROM, [2, 0, 0], radius, 1, new Box3())!.max.x).toBeCloseTo(1 + radius);
+  });
 });
