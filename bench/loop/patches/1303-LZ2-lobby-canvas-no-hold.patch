--- a/client/src/lib/cachedImport.test.ts
+++ b/client/src/lib/cachedImport.test.ts
@@ -1,5 +1,6 @@
 import { describe, expect, it, vi } from 'vitest';
-import { ChunkLoadError, cachedImport } from './cachedImport';
+import { act, renderHook } from '@testing-library/react';
+import { ChunkLoadError, cachedImport, lazyChunk } from './cachedImport';
 
 describe('cachedImport', () => {
   it('loads once for every caller', async () => {
@@ -23,3 +24,25 @@ describe('cachedImport', () => {
     expect(load).toHaveBeenCalledTimes(2);
   });
 });
+
+describe('lazyChunk', () => {
+  it('says when its chunk has arrived, asking for it itself', async () => {
+    let arrive: (m: { default: () => null }) => void = () => {};
+    const load = vi.fn(() => new Promise<{ default: () => null }>((r) => (arrive = r)));
+    const chunk = lazyChunk(load);
+    const { result } = renderHook(() => chunk.useSettled());
+    expect(result.current).toBe(false);
+    expect(load).toHaveBeenCalledTimes(1);
+    await act(async () => arrive({ default: () => null }));
+    expect(result.current).toBe(true);
+  });
+
+  it('says so when its chunk failed, for the boundary to show it', async () => {
+    let fail: (e: Error) => void = () => {};
+    const chunk = lazyChunk(() => new Promise<{ default: () => null }>((_, r) => (fail = r)));
+    const { result } = renderHook(() => chunk.useSettled());
+    expect(result.current).toBe(false);
+    await act(async () => fail(new Error('offline')));
+    expect(result.current).toBe(true);
+  });
+});
