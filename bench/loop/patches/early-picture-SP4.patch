diff --git a/client/src/screens/earlyPicture.test.ts b/client/src/screens/earlyPicture.test.ts
new file mode 100644
index 0000000..730833e
--- /dev/null
+++ b/client/src/screens/earlyPicture.test.ts
@@ -0,0 +1,36 @@
+import { afterEach, expect, test } from 'vitest';
+import { picturePlacement } from '../three/landingLens';
+import { EARLY_PICTURE_ID, dropEarlyPicture, placeEarlyPicture } from './earlyPicture';
+
+afterEach(() => {
+  dropEarlyPicture();
+  document.body.innerHTML = '';
+  window.history.replaceState(null, '', '/');
+});
+
+test('the start page places its picture under the page, where its own will stand', () => {
+  document.body.innerHTML = '<div id="root"></div>';
+  placeEarlyPicture();
+  const early = document.getElementById(EARLY_PICTURE_ID)!;
+  expect(early.nextElementSibling?.id).toBe('root');
+  expect(document.documentElement.hasAttribute('data-early-picture')).toBe(true);
+  const place = picturePlacement(innerWidth, innerHeight);
+  const img = early.querySelector('img')!;
+  expect(img.style.transform).toBe(`translate(${place.left}px, ${place.top}px)`);
+  expect(img.style.width).toBe(`${place.width}px`);
+  expect(img.getAttribute('src')).toBe(`/landing/${place.layout}.webp`);
+  expect(early.querySelector('source')!.getAttribute('srcset')).toContain(
+    `/landing/${place.layout}@2x.avif 2x`,
+  );
+  dropEarlyPicture();
+  expect(document.getElementById(EARLY_PICTURE_ID)).toBeNull();
+  expect(document.documentElement.hasAttribute('data-early-picture')).toBe(false);
+});
+
+test('any other page places none', () => {
+  document.body.innerHTML = '<div id="root"></div>';
+  window.history.replaceState(null, '', '/new');
+  placeEarlyPicture();
+  expect(document.getElementById(EARLY_PICTURE_ID)).toBeNull();
+  expect(document.documentElement.hasAttribute('data-early-picture')).toBe(false);
+});
diff --git a/client/src/screens/earlyPicture.ts b/client/src/screens/earlyPicture.ts
new file mode 100644
index 0000000..ee901ac
--- /dev/null
+++ b/client/src/screens/earlyPicture.ts
@@ -0,0 +1,36 @@
+import { picturePlacement, pictureSource, pictureSourceSet } from '../three/landingLens';
+
+/**
+ * The start page's picture, placed from an inline script in the built page's
+ * body (vite.config.ts) before the entry has loaded and run: on a phone's
+ * network the picture arrives well before the entry, and the browser paints
+ * it at once instead of after React's first render. It lies under the page
+ * (before #root), and the page's night lets it through
+ * (`[data-early-picture] .landing`) until LandingPicture's own picture, the
+ * same file in the same place, has decoded over it.
+ */
+export const EARLY_PICTURE_ID = 'landing-early';
+
+export function placeEarlyPicture(): void {
+  const root = document.getElementById('root');
+  const [width, height] = [innerWidth, innerHeight];
+  if (location.pathname !== '/' || !root || !(width > 0 && height > 0)) return;
+  const place = picturePlacement(width, height);
+  const picture = document.createElement('div');
+  picture.id = EARLY_PICTURE_ID;
+  picture.className = 'landing-picture';
+  picture.setAttribute('aria-hidden', 'true');
+  picture.innerHTML =
+    `<picture><source type="image/avif" srcset="${pictureSourceSet(place.layout, 'avif')}">` +
+    `<img src="${pictureSource(place.layout, 'webp')}" srcset="${pictureSourceSet(place.layout, 'webp')}" ` +
+    `alt="" decoding="async" fetchpriority="high" style="transform: translate(${place.left}px, ${place.top}px); ` +
+    `width: ${place.width}px; height: ${place.height}px"></picture>`;
+  document.body.insertBefore(picture, root);
+  document.documentElement.setAttribute('data-early-picture', '');
+}
+
+/** The page's own picture has taken over, or the start page has gone. */
+export function dropEarlyPicture(): void {
+  document.getElementById(EARLY_PICTURE_ID)?.remove();
+  document.documentElement.removeAttribute('data-early-picture');
+}
