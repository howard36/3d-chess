+
+/** How long the pointer rests on a level before the others step back, ms (r3f's clock). */
+export const FOCUS_DWELL_MS = 200;
+
+/**
+ * The level the pointer has rested on for FOCUS_DWELL_MS (or none, once it
+ * has been off the levels that long): a pointer passing over, or a click
+ * straight after it arrives, steps no level back, so the picture of a pick
+ * or a move does not carry the whole tower's change of focus.
+ */
+export const useDwelledLevel = (level: number | null): number | null => {
+  const invalidate = useThree((s) => s.invalidate);
+  const [shown, setShown] = useState(level);
+  const since = useRef(0);
+  useEffect(() => {
+    since.current = 0;
+    invalidate();
+  }, [level, invalidate]);
+  useFrame((_, delta) => {
+    if (level === shown) return;
+    since.current += Math.min(delta, 1 / 20) * 1000;
+    if (since.current >= FOCUS_DWELL_MS) setShown(level);
+    else invalidate();
+  });
+  return shown;
+};
