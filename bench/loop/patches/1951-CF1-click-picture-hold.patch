@@ -75,3 +95,29 @@ export const PaceOnGpu = () => {
 
 /** The display frames a frame waits for the GPU at most (a second at 60 Hz): a fence that never passes holds nothing. */
 export const PACE_MAX_SKIPS = 60;
+
+/** The longest a picture is held for the move's (holdPicture). */
+export const HOLD_MAX_MS = 120;
+
+type PictureHold = { pending: boolean; since: number; echoMs: number | null };
+
+/**
+ * A move is on its way to the server: its echo brings a picture of its own,
+ * and a slow GPU still drawing the picture before it (the marks put away)
+ * would make the move's wait for it. Until the echo (releasePicture), for no
+ * longer than the GPU's last frame took, the canvas draws nothing; once an
+ * echo has taken longer than that, nothing is held.
+ */
+export const holdPicture = (scene: Object3D) => {
+  const hold = (scene.userData.pictureHold ??= { pending: false, since: 0, echoMs: null });
+  hold.pending = true;
+  hold.since = performance.now();
+};
+
+/** The move is back (`answered`), or will not be: the next picture is drawn. */
+export const releasePicture = (scene: Object3D, answered: boolean) => {
+  const hold = scene.userData.pictureHold as PictureHold | undefined;
+  if (!hold?.pending) return;
+  hold.pending = false;
+  if (answered) hold.echoMs = performance.now() - hold.since;
+};
