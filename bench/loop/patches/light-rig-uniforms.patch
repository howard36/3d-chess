+describe('the glaze light rig', () => {
+  it('rides with the camera: each light the same view-space direction, turned to world', () => {
+    const material = bodyMaterial('white', PieceType.Pawn, 0, 'steady');
+    const camera = new PerspectiveCamera(36, 1, 0.1, 100);
