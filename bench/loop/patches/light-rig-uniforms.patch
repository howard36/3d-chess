+        null as never,
+        camera,
+        null as never,
+        null as never,
+        null as never,
+      );
+      const u = material.uniforms;
+      for (const [name, v] of [
+        ['uKeyDir', [-0.62, 0.6, 0.5]],
+        ['uFillDir', [0.8, -0.05, 0.6]],
+        ['uKickDir', [0.7, 0.4, -0.6]],
+      ] as const) {
+        const expected = new Vector3(...v).transformDirection(camera.matrixWorld);
+        expect((u[name].value as Vector3).distanceTo(expected), name).toBeLessThan(1e-12);
+      }
+    }
+  });
+});
