{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebSocket V1 Message Envelope",
  "oneOf": [
    { "$ref": "#/definitions/create_game" },
    { "$ref": "#/definitions/game_created" },
    { "$ref": "#/definitions/look_game" },
    { "$ref": "#/definitions/game_info" },
    { "$ref": "#/definitions/join_game" },
    { "$ref": "#/definitions/game_joined" },
    { "$ref": "#/definitions/rejoin_game" },
    { "$ref": "#/definitions/game_start" },
    { "$ref": "#/definitions/game_state" },
    { "$ref": "#/definitions/move" },
    { "$ref": "#/definitions/move_made" },
    { "$ref": "#/definitions/resign" },
    { "$ref": "#/definitions/offer_draw" },
    { "$ref": "#/definitions/accept_draw" },
    { "$ref": "#/definitions/decline_draw" },
    { "$ref": "#/definitions/draw_offered" },
    { "$ref": "#/definitions/draw_declined" },
    { "$ref": "#/definitions/game_ended" },
    { "$ref": "#/definitions/presence" },
    { "$ref": "#/definitions/error" }
  ],
  "definitions": {
    "color": { "enum": ["white", "black"] },
    "client_id": {
      "description": "Random id a browser tab picks for itself. The server remembers which tab claimed each seat, so a tab can re-send a join whose answer it lost, and an automatic rejoin can tell its own stale connection from another tab's live one.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "promotion": { "enum": ["Q", "R", "B", "N", "U"] },
    "error_code": {
      "enum": [
        "invalid_message",
        "already_in_game",
        "invalid_game",
        "game_full",
        "invalid_rejoin",
        "invalid_move",
        "game_not_started",
        "wrong_turn",
        "seat_in_use",
        "game_over",
        "invalid_draw"
      ]
    },
    "ending_result": {
      "description": "How a game ended by the players' own decision rather than on the board: one side resigned, or both agreed a draw.",
      "enum": ["resignation", "agreement"]
    },
    "ending": {
      "type": "object",
      "properties": {
        "result": { "$ref": "#/definitions/ending_result" },
        "winner": {
          "description": "The side that won: the resigning side's opponent. Absent for an agreed draw.",
          "$ref": "#/definitions/color"
        }
      },
      "required": ["result"],
      "additionalProperties": false
    },
    "draw_offer": {
      "description": "A draw offered by `by` when `ply` moves had been played. It stands only while that is still the number of moves (a move cancels it) and it has not been answered.",
      "type": "object",
      "properties": {
        "by": { "$ref": "#/definitions/color" },
        "ply": { "type": "integer", "minimum": 0 },
        "declined": {
          "description": "The opponent declined it. A draw can be offered once per move.",
          "type": "boolean"
        }
      },
      "required": ["by", "ply"],
      "additionalProperties": false
    },
    "create_game": {
      "type": "object",
      "properties": {
        "type": { "const": "create_game" },
        "clientId": { "$ref": "#/definitions/client_id" },
        "color": {
          "description": "The side the creator wants to play. Omitted, the server picks one at random.",
          "$ref": "#/definitions/color"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "game_created": {
      "type": "object",
      "properties": {
        "type": { "const": "game_created" },
        "gameId": { "type": "string" },
        "color": { "$ref": "#/definitions/color" }
      },
      "required": ["type", "gameId", "color"],
      "additionalProperties": false
    },
    "look_game": {
      "description": "Asks which seats of a game are taken, without joining it: what an invitation shows before the player accepts.",
      "type": "object",
      "properties": {
        "type": { "const": "look_game" },
        "gameId": { "type": "string" }
      },
      "required": ["type", "gameId"],
      "additionalProperties": false
    },
    "game_info": {
      "type": "object",
      "properties": {
        "type": { "const": "game_info" },
        "gameId": { "type": "string" },
        "seats": {
          "description": "The seats already claimed, in the order they were taken.",
          "type": "array",
          "items": { "$ref": "#/definitions/color" }
        }
      },
      "required": ["type", "gameId", "seats"],
      "additionalProperties": false
    },
    "join_game": {
      "type": "object",
      "properties": {
        "type": { "const": "join_game" },
        "gameId": { "type": "string" },
        "clientId": { "$ref": "#/definitions/client_id" }
      },
      "required": ["type", "gameId"],
      "additionalProperties": false
    },
    "game_joined": {
      "type": "object",
      "properties": {
        "type": { "const": "game_joined" },
        "color": { "$ref": "#/definitions/color" }
      },
      "required": ["type", "color"],
      "additionalProperties": false
    },
    "rejoin_game": {
      "type": "object",
      "properties": {
        "type": { "const": "rejoin_game" },
        "gameId": { "type": "string" },
        "color": { "$ref": "#/definitions/color" },
        "clientId": { "$ref": "#/definitions/client_id" },
        "takeover": {
          "description": "Whether to take the seat from another tab's live connection (the default). An automatic reconnect sends false, and is refused with seat_in_use instead.",
          "type": "boolean"
        }
      },
      "required": ["type", "gameId", "color"],
      "additionalProperties": false
    },
    "game_start": {
      "type": "object",
      "properties": {
        "type": { "const": "game_start" },
        "color": { "$ref": "#/definitions/color" }
      },
      "required": ["type", "color"],
      "additionalProperties": false
    },
    "game_state": {
      "type": "object",
      "properties": {
        "type": { "const": "game_state" },
        "color": { "$ref": "#/definitions/color" },
        "started": { "type": "boolean" },
        "moves": { "type": "array", "items": { "$ref": "#/definitions/move_record" } },
        "ending": {
          "description": "Set once the game has ended by resignation or agreement.",
          "$ref": "#/definitions/ending"
        },
        "drawOffer": {
          "description": "The latest draw offer, if any; it stands only if its ply is the number of moves and it was not declined.",
          "$ref": "#/definitions/draw_offer"
        }
      },
      "required": ["type", "color", "started", "moves"],
      "additionalProperties": false
    },
    "move_record": {
      "type": "object",
      "properties": {
        "by": { "$ref": "#/definitions/color" },
        "from": { "type": "string", "pattern": "^[A-E][a-e][1-5]$" },
        "to": { "type": "string", "pattern": "^[A-E][a-e][1-5]$" },
        "promotion": { "$ref": "#/definitions/promotion" }
      },
      "required": ["by", "from", "to"],
      "additionalProperties": false
    },
    "move": {
      "type": "object",
      "properties": {
        "type": { "const": "move" },
        "from": { "type": "string", "pattern": "^[A-E][a-e][1-5]$" },
        "to": { "type": "string", "pattern": "^[A-E][a-e][1-5]$" },
        "promotion": { "$ref": "#/definitions/promotion" }
      },
      "required": ["type", "from", "to"],
      "additionalProperties": false
    },
    "move_made": {
      "type": "object",
      "properties": {
        "type": { "const": "move_made" },
        "by": { "$ref": "#/definitions/color" },
        "from": { "type": "string", "pattern": "^[A-E][a-e][1-5]$" },
        "to": { "type": "string", "pattern": "^[A-E][a-e][1-5]$" },
        "promotion": { "$ref": "#/definitions/promotion" }
      },
      "required": ["type", "by", "from", "to"],
      "additionalProperties": false
    },
    "resign": {
      "description": "The sender resigns: the opponent wins.",
      "type": "object",
      "properties": { "type": { "const": "resign" } },
      "required": ["type"],
      "additionalProperties": false
    },
    "offer_draw": {
      "description": "The sender offers a draw.",
      "type": "object",
      "properties": { "type": { "const": "offer_draw" } },
      "required": ["type"],
      "additionalProperties": false
    },
    "accept_draw": {
      "description": "The sender accepts the opponent's standing draw offer.",
      "type": "object",
      "properties": { "type": { "const": "accept_draw" } },
      "required": ["type"],
      "additionalProperties": false
    },
    "decline_draw": {
      "description": "The sender declines the opponent's standing draw offer.",
      "type": "object",
      "properties": { "type": { "const": "decline_draw" } },
      "required": ["type"],
      "additionalProperties": false
    },
    "draw_offered": {
      "description": "To both players: `by` offered a draw when `ply` moves had been played.",
      "type": "object",
      "properties": {
        "type": { "const": "draw_offered" },
        "by": { "$ref": "#/definitions/color" },
        "ply": { "type": "integer", "minimum": 0 }
      },
      "required": ["type", "by", "ply"],
      "additionalProperties": false
    },
    "draw_declined": {
      "description": "To both players: `by` declined the draw offered when `ply` moves had been played.",
      "type": "object",
      "properties": {
        "type": { "const": "draw_declined" },
        "by": { "$ref": "#/definitions/color" },
        "ply": { "type": "integer", "minimum": 0 }
      },
      "required": ["type", "by", "ply"],
      "additionalProperties": false
    },
    "game_ended": {
      "description": "To both players: the game ended by resignation or agreement. No move, offer or resignation is accepted after it.",
      "type": "object",
      "properties": {
        "type": { "const": "game_ended" },
        "result": { "$ref": "#/definitions/ending_result" },
        "winner": {
          "description": "The side that won; absent for an agreed draw.",
          "$ref": "#/definitions/color"
        }
      },
      "required": ["type", "result"],
      "additionalProperties": false
    },
    "presence": {
      "type": "object",
      "properties": {
        "type": { "const": "presence" },
        "color": { "$ref": "#/definitions/color" },
        "online": { "type": "boolean" }
      },
      "required": ["type", "color", "online"],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "type": { "const": "error" },
        "code": { "$ref": "#/definitions/error_code" },
        "message": { "type": "string" }
      },
      "required": ["type", "code", "message"],
      "additionalProperties": false
    }
  }
}
